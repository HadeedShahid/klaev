{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "klaev",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name.
			// See https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "klaev"
		}
	],
	"observability": {
		"enabled": true
	}
	// No R2 bucket yet: the incremental cache is the read-only static assets cache (open-next.config.ts).
	// Add NEXT_INC_CACHE_R2_BUCKET when D1 lands and pages need revalidating.
}
