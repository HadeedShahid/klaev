{
  "name": "klaev",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "pnpm cf-typegen && next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply klaev --local",
    "db:seed": "tsx scripts/seed-catalog.ts && wrangler d1 execute klaev --local --file .wrangler/seed/catalog.sql",
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "db:import": "tsx scripts/import-shopify.ts && wrangler d1 execute klaev --local --file data/private/shopify-import.sql",
    "db:migrate:remote": "wrangler d1 migrations apply klaev --remote",
    "admin:password": "tsx scripts/set-admin-password.ts",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && OPEN_NEXT_DEPLOY=true wrangler deploy",
    "cf:upload": "opennextjs-cloudflare build && OPEN_NEXT_DEPLOY=true wrangler versions upload"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@jsquash/webp": "1.5.0",
    "@opennextjs/cloudflare": "^1.20.13",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@next/playwright": "16.4.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "csv-parse": "^7.0.3",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "^30.1.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "packageManager": "pnpm@10.33.0"
}
