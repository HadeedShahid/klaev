{
	"$schema": "node_modules/wrangler/config-schema.json",
	// OpenNext's worker, wrapped to set what Workers Cache keeps (worker.ts).
	"main": "worker.ts",
	"name": "klaev",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	// Workers Cache: store pages are answered from Cloudflare's cache without running the Worker.
	// lib/edge-cache.ts decides what's kept, refreshStore() purges it, and each deploy starts empty.
	"cache": { "enabled": true },
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name.
			// See https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "klaev"
		}
	],
	"d1_databases": [
		{
			// The store database: catalog, stock, customers, orders and payments. Schema in lib/db/schema.ts,
			// migrations in drizzle/. Local development and CI use a local copy under .wrangler/state.
			"binding": "DB",
			"database_name": "klaev",
			"database_id": "db113c94-9161-419e-8d1c-46d137eab5d5",
			"migrations_dir": "drizzle"
		},
		{
			// The same database again, under the name OpenNext's tag cache looks for: refreshing a page
			// after an order is recorded in its revalidations table (drizzle/0002_page_revalidations.sql).
			"binding": "NEXT_TAG_CACHE_D1",
			"database_name": "klaev",
			"database_id": "db113c94-9161-419e-8d1c-46d137eab5d5"
		}
	],
	"r2_buckets": [
		{
			// OpenNext's page cache (open-next.config.ts).
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			"bucket_name": "klaev-cache"
		},
		{
			// Bank transfer receipts customers upload. Private: no public URL.
			"binding": "RECEIPTS",
			"bucket_name": "klaev-receipts"
		},
		{
			// Product photos (lib/media.ts). The store reads them from the bucket's public address;
			// the admin writes new ones through this binding.
			"binding": "MEDIA",
			"bucket_name": "klaev-media"
		}
	],
	// Sign-in tries per address on /admin/login (lib/admin/auth.ts). The period is 10 or 60 seconds.
	"ratelimits": [
		{
			"name": "ADMIN_SIGN_IN_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 5, "period": 60 }
		},
		// Order lookups on /track: enough for a customer, too few to guess numbers and phones.
		{
			"name": "TRACK_LIMITER",
			"namespace_id": "1002",
			"simple": { "limit": 10, "period": 60 }
		},
		// Page views from the tracker: far more than any person, few enough to keep a script from flooding them.
		{
			"name": "EVENTS_LIMITER",
			"namespace_id": "1003",
			"simple": { "limit": 120, "period": 60 }
		}
	],
	"observability": {
		"enabled": true
	}
}
