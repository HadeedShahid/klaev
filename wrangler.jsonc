{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "klaev",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name.
			// See https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "klaev"
		}
	],
	"d1_databases": [
		{
			// The store database: catalog, stock, customers, orders and payments. Schema in lib/db/schema.ts,
			// migrations in drizzle/. Local development and CI use a local copy under .wrangler/state.
			"binding": "DB",
			"database_name": "klaev",
			"database_id": "db113c94-9161-419e-8d1c-46d137eab5d5",
			"migrations_dir": "drizzle"
		}
	],
	"r2_buckets": [
		{
			// OpenNext's page cache (open-next.config.ts).
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			"bucket_name": "klaev-cache"
		}
	],
	"observability": {
		"enabled": true
	}
}
